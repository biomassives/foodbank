{
  "name": "food-bank",
  "version": "0.0.1",
  "description": "A Quasar Project",
  "productName": "Funky Pony Space",
  "author": "",
  "private": true,
  "scripts": {
    "lint": "eslint --ext .js,.ts,.vue ./",
    "format": "prettier --write \"**/*.{js,ts,vue,scss,html,md,json}\" --ignore-path .gitignore",
    "test": "jest --verbose --json --outputFile=public/test-results.json",
    "test:sprint1": "jest tests/sprint1 --verbose --json --outputFile=public/test-results.json",
    "test:unit": "jest tests/unit --verbose --json --outputFile=public/test-results.json",
    "test:report": "jest --json --outputFile=public/test-results.json --verbose",
    "test:e2e": "dotenv -e .env.test -- jest --config jest.e2e.config.ts",
    "test:e2e:vercel": "dotenv -e .env.test -- cross-env BASE_URL=$VERCEL_URL jest --config jest.e2e.config.ts",
    "test:e2e:netlify": "dotenv -e .env.test -- cross-env BASE_URL=$NETLIFY_URL jest --config jest.e2e.config.ts",
    "test:e2e:appwrite": "dotenv -e .env.test -- cross-env BASE_URL=$APPWRITE_URL jest --config jest.e2e.config.ts",
    "test:e2e:replit": "dotenv -e .env.test -- cross-env BASE_URL=$REPLIT_URL jest --config jest.e2e.config.ts",
    "test:e2e:record": "dotenv -e .env.test -- jest --config jest.e2e.config.ts --testPathPattern=record-",
    "serve:spa": "node scripts/serve-spa.js",
    "dev": "quasar dev",
    "build": "npm run test:report && quasar build"
  },
  "dependencies": {
    "@quasar/extras": "^1.16.4",
    "@supabase/supabase-js": "^2.95.3",
    "@types/lodash.uniqueid": "^4.0.9",
    "@vercel/analytics": "^1.6.1",
    "idb": "^8.0.0",
    "lodash.uniqueid": "^4.0.1",
    "pinia": "^2.1.7",
    "puppeteer-screen-recorder": "^3.0.6",
    "quasar": "^2.8.0",
    "supabase": "^2.76.11",
    "vue": "^3.2.29",
    "vue-router": "^4.0.12"
  },
  "devDependencies": {
    "@babel/preset-env": "^7.23.8",
    "@babel/preset-typescript": "^7.23.3",
    "@quasar/app-vite": "^1.4.3",
    "@types/jest": "^29.5.11",
    "@types/jest-environment-puppeteer": "^5.0.6",
    "@types/node": "^12.20.21",
    "@typescript-eslint/eslint-plugin": "^5.10.0",
    "@typescript-eslint/parser": "^5.10.0",
    "@vue/test-utils": "^2.4.3",
    "@vue/vue3-jest": "^29.2.6",
    "autoprefixer": "^10.4.2",
    "babel-jest": "^29.7.0",
    "cross-env": "^7.0.3",
    "dotenv-cli": "^7.4.2",
    "eslint": "^8.11.0",
    "eslint-config-prettier": "^8.1.0",
    "eslint-plugin-vue": "^9.0.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "jest-puppeteer": "^11.0.0",
    "prettier": "^2.5.1",
    "puppeteer": "^24.38.0",
    "ts-jest": "^29.1.2",
    "ts-node": "^10.9.2",
    "typescript": "^4.5.4"
  },
  "engines": {
    "node": "^22 || ^20 || ^18",
    "npm": ">= 6.13.4",
    "yarn": ">= 1.21.1"
  }
}
